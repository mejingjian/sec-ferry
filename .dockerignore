# 依赖与本地状态。
node_modules
.npm

# 构建产物：都在 builder 阶段重新生成（开发机上可能是别的平台的产物）
.next
.local-data

# 仓库与本地工作区杂物
.git
.gitignore
.workbuddy
.agents
.codex
.agents
outputs
work
tmp
.tmp-*
_*.tmp
_*.log
_*.mjs
*.tsbuildinfo

# 本地私有配置与密钥（容器内的配置全部来自环境变量）
.env
.env.*
local.config.json

# 文档不进镜像（截图等文档资产只服务 README，没必要进构建上下文）
*.md
docs
docker-compose.yml
