# 容器部署环境模板：复制为 .env.docker 后填写（不是 .env！）
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d            # 或用 npm run docker:up
#
# ⚠️ 不要写进根目录的 .env：那份是本地开发用的，容器若复用它就等于把开发密钥
#    带进容器 —— 开发机密钥一旦泄漏，容器里加密的 LDAP 口令会跟着一起失效。
#    两份文件各管一套，互不影响。
# .env.docker 已被 .gitignore 的 `.env*` 排除，不会进仓库也不会进镜像。
#
# ===== 必填 =====

# 会话签名 + LDAP 密码加密。至少要 32 个字符。
# 生成：openssl rand -hex 32
# ⚠️ 上线后不可更换 —— 换了所有会话失效，且已存的 LDAP 密码无法解密。请离线备份。
CONFIG_ENCRYPTION_KEY=

# ===== 按需调整 =====

# 隔离区文件保留天数，需与合规要求一致
QUARANTINE_RETENTION_DAYS=7

# ===== 角色名单（逗号分隔）=====
# ⚠️ PLATFORM_ADMIN_EMAILS 一旦配置，「本地管理员」兜底登录会自动禁用 —— 生产必须配置，
#    否则任何人都能用自声明邮箱登录。
#    配置它同时也是「登录必须校验域密码」的开关：未配置时平台处于联调态，
#    允许自声明邮箱登录（不校验密码）；生产必须配置，届时只剩 LDAP bind 一条登录路径。
PLATFORM_ADMIN_EMAILS=
PLATFORM_APPROVER_EMAILS=
PLATFORM_AUDITOR_EMAILS=

# ===== 登录安全（域账号 + 域密码）=====
# 是否允许"自声明登录"（只填邮箱、不校验密码）。仅联调环境可设 true；
# 不设置时的默认值 = 未配置 PLATFORM_ADMIN_EMAILS（即联调态才放开）。
ALLOW_SELF_DECLARED_LOGIN=false
# 连续失败多少次锁定账号 / 锁定多少分钟（防域账号在线爆破）
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ===== 端口绑定 =====
# 0.0.0.0 = 监听所有网卡，内网同事用 http://<本机内网IP>:8787 即可访问；
# 本平台就是给内网多人共同使用的，所以默认按这个配。只想本机可访问就改回 127.0.0.1。
# 注意：开放前请确认所在网段可信；要收敛来源可让宿主机防火墙只放行审批网段。
PLATFORM_BIND=0.0.0.0

# 镜像标签，回滚时指定上一个标签即可
IMAGE_TAG=latest

# ===== 仅 --profile dev（测试用 LDAP）=====
# 生产请连内网真实 AD，不要启用 dev profile。
LDAP_DOMAIN=example.local
LDAP_ORGANISATION=Example Corp
LDAP_ADMIN_PASSWORD=admin
LDAP_CONFIG_PASSWORD=config
LDAP_BIND=127.0.0.1

# ===== LDAP 目录同步（可选）=====
# 每页条目数。AD 单次搜索默认最多返回 1000 条，目录大的单位需要分页，否则同步结果为空。
# 设为 0 表示关闭分页（完全依赖目录自身限制）。
LDAP_PAGE_SIZE=500
# LDAPS 严格校验证书。内网 AD 常用自签名证书，故默认 false；
# 若目录已换成受信证书，设为 true 可启用完整校验。
LDAP_TLS_REJECT_UNAUTHORIZED=false

# ===== 邮件通知（可选，SMTP 服务器地址等在管理页配置）=====
# SMTP 严格校验服务器证书（默认 true）。内网邮件中继常用自签名证书，
# 连不上且报证书错误时设为 false 关闭校验。
#SMTP_TLS_REJECT_UNAUTHORIZED=true

# ===== 备份 sidecar（可选）=====
# 备份周期（秒），默认 24 小时；数据库备份保留份数由 BACKUP_KEEP 控制
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14
