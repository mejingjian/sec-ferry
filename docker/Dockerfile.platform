# syntax=docker/dockerfile:1
# 审批平台镜像（三阶段：依赖 → 构建 → 运行）。
#
# 与重构前的关键差别：
#   旧：运行时是 workerd（靠 wrangler dev 拉起 dist），运行阶段还要 `npm install --include=dev wrangler`，
#       并在容器启动时生成 wrangler.local.json。原因是应用通过 Worker 绑定读环境。
#   新：标准 Node 服务器（Next standalone 的 server.js），运行阶段只 COPY 产物、不装任何包；
#       环境变量全部走 process.env；启动时不再生成任何配置文件。镜像因此小得多、启动快得多。
#
# 数据全部落在 /data 卷：/data/db/platform.db（SQLite）+ /data/files（隔离区对象）+ /data/backups。
#
# 运行时下限是 Node 22.16（用到 node:sqlite 的 sqlite.backup() / statement.setReturnArrays()，
# 依据见 db/runtime.mjs）。这里用 node:22-bookworm-slim = 22 线最新补丁，恰好覆盖下限；
# **不要**为了「锁版本」把它钉成 22.13 / 22.15 之类的旧补丁 —— 那样平台会直接起不来。

# ---------- 1) 依赖阶段：只装依赖，源码变更不会让这层失效 ----------
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --no-audit --no-fund

# ---------- 2) 构建阶段 ----------
FROM node:22-bookworm-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# next build + scripts/assemble-standalone.mjs（把 static/public/drizzle 放进 standalone 目录）
RUN npm run build

# ---------- 3) 运行阶段：只放产物，没有任何安装步骤 ----------
FROM node:22-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=8787 \
    HOSTNAME=0.0.0.0 \
    DATA_DIR=/data

# standalone 产物已包含最小 node_modules、server.js、.next/static、public 与 drizzle
COPY --from=builder /app/.next/standalone ./
# 迁移 CLI：让「启动前迁移」能 fail-fast（应用内也会惰性迁移，两者共用 db/*.mjs 同一份逻辑）
COPY --from=builder /app/db/migrations.mjs /app/db/sqlite-client.mjs /app/db/crypto.mjs /app/db/audit-chain.mjs ./db/
# preflight.mjs  —— 启动前自检（配置错误在启动那一刻就暴露）
# reset-admin.mjs—— 应急诊断 / 恢复（不依赖服务进程，平台起不来时也能用）
COPY --from=builder /app/scripts/migrate.mjs /app/scripts/backup.mjs /app/scripts/preflight.mjs /app/scripts/reset-admin.mjs /app/scripts/rekey.mjs ./scripts/
# 备份脚本要能在容器里独立执行（backup sidecar 复用同一镜像）
COPY --from=builder /app/package.json ./package.json

COPY docker/entrypoint-platform.sh /usr/local/bin/entrypoint-platform.sh
RUN chmod +x /usr/local/bin/entrypoint-platform.sh \
 && mkdir -p /data/db /data/files /data/backups \
 && useradd --system --uid 10001 --create-home app \
 && chown -R app:app /app /data

USER app
EXPOSE 8787

# 存活探针：只问「进程还能响应 HTTP 吗」，不查数据库（避免依赖抖动引发重启风暴）
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8787)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/local/bin/entrypoint-platform.sh"]
