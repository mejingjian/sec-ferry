{
  "name": "transfer-approval-platform",
  "version": "1.0.0",
  "description": "内网文件安全收发审批平台（Next.js standalone + SQLite + LDAP 直连，局域网自托管）",
  "license": "MIT",
  "author": "mejingjian <mejingjian@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mejingjian/sec-ferry.git"
  },
  "bugs": {
    "url": "https://github.com/mejingjian/sec-ferry/issues"
  },
  "homepage": "https://github.com/mejingjian/sec-ferry#readme",
  "keywords": [
    "file-transfer",
    "approval-workflow",
    "audit-log",
    "ldap",
    "self-hosted",
    "intranet",
    "nextjs",
    "sqlite"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 8787",
    "build": "next build && node scripts/assemble-standalone.mjs",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:status": "node --env-file-if-exists=.env scripts/migrate.mjs --status",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "rekey": "node --env-file-if-exists=.env scripts/rekey.mjs",
    "bootstrap": "node --env-file-if-exists=.env scripts/bootstrap.mjs",
    "test:rekey": "node scripts/test-rekey.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "admin:inspect": "node --env-file-if-exists=.env scripts/reset-admin.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:encoding",
    "local:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/local-setup.ps1",
    "local:start": "powershell -ExecutionPolicy Bypass -File ./scripts/local-start.ps1",
    "local:reset": "node scripts/reset-demo-data.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "e2e": "node scripts/e2e-internal-transfer.mjs",
    "docker:build": "docker compose --env-file .env.docker build",
    "docker:up": "docker compose --env-file .env.docker up -d",
    "docker:up:dev": "docker compose --env-file .env.docker --profile dev up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=100",
    "docker:smoke": "node scripts/smoke-test.mjs --base http://127.0.0.1:8787 --write"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "ldapts": "9.2.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
